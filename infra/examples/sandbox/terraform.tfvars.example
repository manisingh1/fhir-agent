# Replace these placeholders with existing IAM user/role ARNs, not STS sessions.
account_id = "000000000000"
region     = "us-east-2"
name       = "fhir-agent-sandbox"
admin_principal_arns     = ["arn:aws:iam::000000000000:role/TerraformDeployer"]
signer_principal_arns    = ["arn:aws:iam::000000000000:user/YOUR_USER"]
publisher_principal_arns = ["arn:aws:iam::000000000000:role/JWKSPublisher"]
key_versions            = ["v1"]
active_key_version      = "v1"
