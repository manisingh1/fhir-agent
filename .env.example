# Set the non-production client identifier from your Epic app registration.
EPIC_CLIENT_ID=replace-with-your-epic-sandbox-client-id
EPIC_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
EPIC_KEY_ID=replace-with-public-jwks-kid
# Select exactly one signing-key source. AWS calls occur only when used.
EPIC_PRIVATE_KEY_PATH=
EPIC_PRIVATE_KEY_SECRET_ID=
# Asymmetric RSA SIGN_VERIFY key ID/ARN; use a stable key ARN, not a rotating alias.
EPIC_KMS_KEY_ID=
AWS_REGION=us-east-2
# Optional; omit for the existing Epic backend flow unless required by your server.
EPIC_SCOPES=
